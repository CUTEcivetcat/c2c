<view class="im fade-up">
  <view class="card glass-card" wx:for="{{list}}" wx:key="id">
    <view class="hd">
      <text class="st chip {{item.status === 3 ? 'done' : ''}}">{{statuses[item.status] || ''}}</text>
      <text class="time">{{item._time}}</text>
    </view>
    <view class="bd" bindtap="goProduct" data-id="{{item.productId}}">
      <image class="img" wx:if="{{item.productCover}}" src="{{item.productCover}}" mode="aspectFill"/>
      <view class="info">
        <text class="t">{{item.productTitle}}</text>
        <view class="p-line">
          <text class="p">¥{{item.productPrice}}</text>
          <text class="expect" wx:if="{{item.expectedPrice}}">期望 ¥{{item.expectedPrice}}</text>
        </view>
      </view>
      <text class="ar">›</text>
    </view>
    <view class="msg" wx:if="{{item.message}}">留言：{{item.message}}</view>
    <view class="reply" wx:if="{{item.sellerReply}}">卖家回复：{{item.sellerReply}}</view>
    <view class="ops" wx:if="{{item.status === 1 || item.status === 2}}">
      <button class="btn-mini danger" bindtap="close" data-id="{{item.id}}">关闭意向</button>
    </view>
  </view>

  <view class="spinner" wx:if="{{loading}}"></view>
  <view class="empty" wx:if="{{!loading && !list.length}}">
    <text class="empty-ico">💭</text>
    还没有发出过意向，去商品页点"我想要"吧
  </view>
</view>
