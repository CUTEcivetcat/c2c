.is { padding: 28rpx 24rpx; background: transparent; }
.card { padding: 24rpx; margin-bottom: 18rpx; }
.hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.buyer { display: flex; align-items: center; gap: 14rpx; }
.b-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--primary-soft); overflow: hidden; }
.b-avatar.text { color: var(--primary); font-size: 26rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.b-name { font-size: 27rpx; font-weight: 600; color: var(--ink); }
.st.done { background: var(--success); color: #fff; }
.bd { display: flex; gap: 20rpx; align-items: center; }
.img { width: 110rpx; height: 110rpx; border-radius: 16rpx; background: #eef1f5; flex-shrink: 0; }
.info { flex: 1; min-width: 0; }
.t { font-size: 28rpx; color: var(--ink); line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.p-line { display: flex; align-items: baseline; gap: 18rpx; margin-top: 10rpx; }
.p { font-size: 30rpx; font-weight: 800; color: var(--primary); }
.expect { font-size: 22rpx; color: var(--warning); }
.ar { color: var(--ink-3); font-size: 30rpx; flex-shrink: 0; }
.msg { margin-top: 16rpx; font-size: 25rpx; color: var(--ink-2); background: var(--bg); border-radius: var(--radius); padding: 16rpx 20rpx; line-height: 1.6; }
.reply { margin-top: 12rpx; font-size: 25rpx; color: var(--success); background: rgba(7,193,96,0.08); border-radius: var(--radius); padding: 16rpx 20rpx; line-height: 1.6; }
.time-row { margin-top: 14rpx; font-size: 22rpx; color: var(--ink-3); }
.ops { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 16rpx; }
.reply-input { width: 100%; box-sizing: border-box; height: 180rpx; background: var(--bg); border-radius: var(--radius); padding: 20rpx 24rpx; font-size: 28rpx; margin-bottom: 26rpx; }
.ph { color: var(--ink-3); }
.reply-submit { width: 100%; padding: 24rpx 0; }
