.sp { padding: 24rpx; background: transparent; }

.bar { display: flex; align-items: center; gap: 18rpx; }
.search-box {
  flex: 1; height: 84rpx; background: #fff;
  border-radius: 999rpx; border: 2rpx solid var(--line);
  display: flex; align-items: center; padding: 0 26rpx;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.25s, box-shadow 0.25s;
}
.search-box:focus-within { border-color: var(--primary); box-shadow: 0 0 0 6rpx rgba(255,107,53,0.12); }
.s-ico { color: var(--primary); font-size: 32rpx; margin-right: 14rpx; }
.s-input { flex: 1; font-size: 28rpx; }
.ph { color: var(--ink-3); }
.s-btn {
  width: 120rpx; height: 84rpx; line-height: 84rpx; padding: 0;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff; font-size: 28rpx; font-weight: 600;
  border-radius: 999rpx; border: none; box-shadow: var(--shadow-md);
}
.s-btn:active { transform: scale(0.97); }

.tags { margin-top: 40rpx; }
.row { display: flex; flex-wrap: wrap; align-items: center; gap: 18rpx 16rpx; margin-bottom: 30rpx; }
.tag-label { font-size: 26rpx; color: var(--ink-3); width: 100%; margin-bottom: 4rpx; font-weight: 600; }
.tag {
  padding: 12rpx 28rpx; border-radius: 999rpx;
  background: #fff; font-size: 26rpx; color: var(--ink-2);
  border: 2rpx solid var(--line);
  transition: all 0.2s ease;
}
.tag:active { background: var(--primary-soft); color: var(--primary); border-color: var(--primary); }
.tag.hot { color: var(--primary); background: var(--primary-soft); border-color: transparent; }
.clear { font-size: 24rpx; color: var(--danger); margin-left: auto; }

.list { padding-top: 10rpx; }
.card {
  display: flex; gap: 20rpx; padding: 20rpx; margin-bottom: 18rpx; align-items: center;
}
.card:active { transform: scale(0.99); }
.img { width: 140rpx; height: 140rpx; border-radius: 16rpx; background: #eef1f5; flex-shrink: 0; }
.info { flex: 1; min-width: 0; }
.t {
  font-size: 28rpx; color: var(--ink); line-height: 1.4;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.p-line { display: flex; align-items: baseline; justify-content: space-between; margin-top: 12rpx; }
.p { font-size: 34rpx; font-weight: 800; color: var(--primary); }
.loc { font-size: 22rpx; color: var(--ink-3); }