<view class="ep fade-up">
  <view class="field">
    <text class="label">收货人</text>
    <input class="inp" placeholder="请输入收货人姓名" placeholder-class="ph"
           value="{{receiverName}}" data-k="receiverName" bindinput="onInput"/>
  </view>
  <view class="field">
    <text class="label">手机号</text>
    <input class="inp" type="number" maxlength="11" placeholder="请输入手机号"
           placeholder-class="ph" value="{{phone}}" data-k="phone" bindinput="onInput"/>
  </view>
  <view class="field">
    <text class="label">省份</text>
    <input class="inp" placeholder="如：广东省" placeholder-class="ph"
           value="{{province}}" data-k="province" bindinput="onInput"/>
  </view>
  <view class="field">
    <text class="label">城市</text>
    <input class="inp" placeholder="如：深圳市" placeholder-class="ph"
           value="{{city}}" data-k="city" bindinput="onInput"/>
  </view>
  <view class="field">
    <text class="label">区/县</text>
    <input class="inp" placeholder="如：南山区" placeholder-class="ph"
           value="{{district}}" data-k="district" bindinput="onInput"/>
  </view>
  <view class="field">
    <text class="label">详细地址</text>
    <input class="inp" placeholder="街道门牌号等" placeholder-class="ph"
           value="{{detail}}" data-k="detail" bindinput="onInput"/>
  </view>
  <view class="field">
    <text class="label">邮编</text>
    <input class="inp" placeholder="选填" placeholder-class="ph"
           value="{{postalCode}}" data-k="postalCode" bindinput="onInput"/>
  </view>

  <button class="save-btn btn-primary" bindtap="save" disabled="{{saving}}">{{saving ? '保存中...' : '保 存'}}</button>
</view>