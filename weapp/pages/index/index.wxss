.page { padding: 12px; min-height: 100vh; background: #f8f9fa; }
.header { text-align: center; padding: 24px 0; }
.title { font-size: 22px; font-weight: 700; color: #2d3436; }
.subtitle { display: block; font-size: 12px; color: #ff6b35; margin-top: 4px; }
.product-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.product-card { width: calc(50% - 5px); background: #fff; border-radius: 12px; overflow: hidden; }
.card-img { width: 100%; height: 160px; background: #f0f2f5; }
.card-body { padding: 10px 12px; }
.card-title { font-size: 14px; font-weight: 600; color: #2d3436; display: -webkit-box; -webkit-line-clamp: 2; overflow: hidden; }
.card-price { display: block; margin-top: 4px; font-size: 16px; font-weight: 700; color: #ff6b35; }
.loading { text-align: center; padding: 40px; color: #b2bec3; }