<view class="page fade-up">
  <!-- 顶部品牌区 -->
  <view class="hero glass-card">
    <view class="hero-top">
      <view class="brand">
        <text class="brand-name">校园二手交易平台</text>
        <text class="brand-slogan">C2C 二手好物 · 用心换新</text>
      </view>
      <view class="chat-ico" bindtap="goSearch">⌕</view>
    </view>
    <view class="search-pill" bindtap="goSearch">
      <text class="search-ico">⌕</text>
      <text class="search-ph">搜索想要的好物…</text>
    </view>
  </view>

  <!-- 轮播图 -->
  <swiper class="banner" wx:if="{{banners.length}}" autoplay circular interval="4000" indicator-dots indicator-color="rgba(255,255,255,.5)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-img" src="{{item.imageUrl}}" mode="aspectFill" binderror="onBannerError" data-index="{{index}}"/>
    </swiper-item>
  </swiper>

  <!-- 公告横幅 -->
  <view class="notice-bar glass-card" wx:if="{{notices.length}}" bindtap="goNotices">
    <text class="notice-tag">公告</text>
    <text class="notice-text">{{notices[0].title}}</text>
    <text class="notice-ar">›</text>
  </view>

  <!-- 分类快捷入口 -->
  <view class="cat-row glass-card" wx:if="{{categories.length}}">
    <view class="cat-item" wx:for="{{categories}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
      <view class="cat-ico">
        <image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFill"/>
        <image wx:elif="{{catIcon(item.name)}}" src="{{catIcon(item.name)}}" mode="aspectFill"/>
        <text wx:else>🛍</text>
      </view>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view class="sort-item {{sort === item.key ? 'active' : ''}}"
          wx:for="{{sortOptions}}" wx:key="key"
          bindtap="onSort" data-key="{{item.key}}">{{item.label}}</view>
  </view>

  <!-- 商品网格 -->
  <view class="grid-header">
    <text class="grid-title">热卖好物</text>
    <text class="grid-sub">{{products.length}} 件在售</text>
  </view>

  <!-- 骨架屏 -->
  <view class="product-grid" wx:if="{{loading && !products.length}}">
    <view class="product-card skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="sk-img"></view>
      <view class="sk-body">
        <view class="sk-line w90"></view>
        <view class="sk-line w60"></view>
        <view class="sk-line w40"></view>
      </view>
    </view>
  </view>

  <view class="product-grid">
    <view class="product-card glass-card fade-up"
          wx:for="{{products}}" wx:key="id"
          bindtap="goProduct" data-id="{{item.id}}">
      <image class="card-img" src="{{item.images && item.images[0] ? item.images[0].url : ''}}" mode="aspectFill"
             lazy-load="{{true}}"/>
      <view class="card-body">
        <text class="card-title">{{item.title}}</text>
        <view class="card-meta">
          <text class="card-cond" wx:if="{{item.conditionText}}">{{item.conditionText}}</text>
        </view>
        <view class="card-bottom">
          <text class="card-price">¥{{item.price}}</text>
          <text class="card-loc">{{item.location || '同城'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{!loading && !products.length}}">
    <text class="empty-ico">🛍</text>
    暂时没有商品,去发布第一个吧
  </view>

  <!-- 加载中 -->
  <view class="spinner" wx:if="{{loading && !products.length}}"></view>

  <!-- 底部到达提示 -->
  <view class="no-more" wx:if="{{!hasMore && products.length}}">— 已经到底啦 —</view>
</view>
