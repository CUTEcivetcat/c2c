<view class="page fade-up">
  <!-- 顶部品牌区 -->
  <view class="hero glass-card">
    <view class="hero-top">
      <view class="brand">
        <text class="brand-name">闲小鱼</text>
        <text class="brand-slogan">C2C 二手好物 · 用心换新</text>
      </view>
      <view class="chat-ico" bindtap="goSearch">⌕</view>
    </view>
    <view class="search-pill" bindtap="goSearch">
      <text class="search-ico">⌕</text>
      <text class="search-ph">搜索想要的好物…</text>
    </view>
  </view>

  <!-- 商品网格 -->
  <view class="grid-header">
    <text class="grid-title">热卖好物</text>
    <text class="grid-sub">{{products.length}} 件在售</text>
  </view>

  <view class="product-grid">
    <view class="product-card glass-card fade-up"
          wx:for="{{products}}" wx:key="id"
          bindtap="goProduct" data-id="{{item.id}}">
      <image class="card-img" src="{{item.images && item.images[0] ? item.images[0].url : ''}}" mode="aspectFill"
             lazy-load="{{true}}"/>
      <view class="card-body">
        <text class="card-title">{{item.title}}</text>
        <view class="card-bottom">
          <text class="card-price">¥{{item.price}}</text>
          <text class="card-loc">{{item.location || '同城'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{!products.length}}">
    <text class="empty-ico">🛍</text>
    暂时没有商品,去发布第一个吧
  </view>

  <!-- 加载中 -->
  <view class="spinner" wx:if="{{loading && !products.length}}"></view>

  <!-- 底部到达提示 -->
  <view class="no-more" wx:if="{{!hasMore && products.length}}">— 已经到底啦 —</view>
</view>