.pub-page { padding: 28rpx 24rpx 180rpx; background: transparent; }
.field-group, .image-group {
  background: var(--glass); border-radius: var(--radius-lg);
  padding: 8rpx 24rpx; box-shadow: var(--shadow-sm);
  margin-bottom: 20rpx; border: 1rpx solid rgba(255,255,255,0.9);
}
.field { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.field:last-child { border-bottom: none; }
.label { width: 110rpx; font-size: 27rpx; color: var(--ink-2); flex-shrink: 0; font-weight: 600; }
.value { flex: 1; font-size: 28rpx; color: var(--ink); }
.value.prep { flex: 1; }
.value-prepend { font-size: 28rpx; color: var(--ink); font-weight: 600; }
.arrow { color: var(--ink-3); font-size: 32rpx; }
.ph { color: var(--ink-3); }
.field.pick { cursor: pointer; }
.field.col { flex-direction: column; align-items: stretch; gap: 14rpx; }
.desc { width: 100%; height: 180rpx; font-size: 27rpx; line-height: 1.6; }
.image-group { padding: 24rpx 22rpx 30rpx; }
.img-head { display: flex; align-items: baseline; gap: 14rpx; margin-bottom: 20rpx; }
.group-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.group-sub { font-size: 24rpx; color: var(--ink-3); }
.img-list { display: flex; flex-wrap: wrap; gap: 18rpx; }
.img-item { position: relative; width: 150rpx; height: 150rpx; }
.img-item image { width: 100%; height: 100%; border-radius: 16rpx; }
.del {
  position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx;
  border-radius: 50%; background: var(--danger); color: #fff; font-size: 24rpx;
  display: flex; align-items: center; justify-content: center; z-index: 2;
}
.add-img {
  width: 150rpx; height: 150rpx; border: 3rpx dashed #ccd3dc;
  border-radius: 16rpx; display: flex; align-items: center; justify-content: center;
}
.add-ic { font-size: 60rpx; color: var(--ink-3); line-height: 1; }
.submit {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 24rpx;
  padding: 26rpx 0; z-index: 10;
}