.wp { padding: 28rpx 24rpx; background: transparent; }
.bal { padding: 48rpx 30rpx; text-align: center; border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: #fff;
  box-shadow: var(--shadow-md); position: relative; overflow: hidden; }
.b-label { font-size: 26rpx; opacity: .9; }
.b-num { display: block; font-size: 68rpx; font-weight: 800; margin: 16rpx 0; }
.b-btn { background: #fff; color: var(--primary); border-radius: 999rpx; font-size: 26rpx; padding: 12rpx 60rpx; display: inline-block; font-weight: 600; }
.logs-title { font-size: 30rpx; font-weight: bold; margin: 30rpx 6rpx 16rpx; }
.log { display: flex; justify-content: space-between; align-items: center; padding: 24rpx;
  border-radius: var(--radius); margin-bottom: 12rpx;
  background: var(--glass); box-shadow: var(--shadow-sm); border: 1rpx solid rgba(255,255,255,0.9); }
.l-side { display: flex; flex-direction: column; gap: 4rpx; }
.l-type { font-size: 26rpx; color: var(--ink); font-weight: 600; }
.l-remark { font-size: 22rpx; color: var(--ink-3); }
.l-amt { font-size: 28rpx; font-weight: 800; }
.l-amt.up { color: var(--success); }
.l-amt.down { color: var(--danger); }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.5); display: flex; align-items: flex-end; z-index: 50; }
.sheet { background: #fff; width: 100%; border-radius: 32rpx 32rpx 0 0; padding: 40rpx 30rpx 60rpx; text-align: center; }
.sheet-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.amt-input { border: 2rpx solid var(--line); border-radius: var(--radius); padding: 20rpx; font-size: 40rpx; margin: 24rpx 0; text-align: center; width: 100%; box-sizing: border-box; }
.confirm { width: 100%; padding: 24rpx 0; color: #fff; background: linear-gradient(135deg, var(--primary), var(--primary-light)); }