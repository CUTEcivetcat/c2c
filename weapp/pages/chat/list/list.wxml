<view class="cl fade-up">
  <view class="conv glass-card" wx:for="{{conversations}}" wx:key="id"
        bindtap="goChat" data-c="{{item}}">
    <view class="avatar-wrap">
      <image wx:if="{{item._otherAvatar}}" class="avatar-img" src="{{item._otherAvatar}}" mode="aspectFill"/>
      <view wx:else class="avatar-text">{{item._otherName ? item._otherName[0] : '鱼'}}</view>
      <view class="badge-dot" wx:if="{{item._unread > 0}}">{{item._unread > 99 ? '99+' : item._unread}}</view>
    </view>
    <view class="conv-info">
      <view class="conv-top">
        <text class="conv-name">{{item._otherName}}</text>
        <text class="conv-time">{{item._time}}</text>
      </view>
      <text class="conv-last">{{item.lastMessage || '开始聊天吧～'}}</text>
    </view>
  </view>

  <view class="spinner" wx:if="{{loading}}"></view>
  <view class="empty" wx:if="{{!loading && !conversations.length}}">
    <text class="empty-ico">💬</text>
    暂无消息，去商品页联系卖家吧
  </view>
</view>
