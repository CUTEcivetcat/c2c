.cd { height: 100vh; display: flex; flex-direction: column; background: var(--bg); }

.msg-area { flex: 1; padding: 24rpx; box-sizing: border-box; }
.load-more { text-align: center; font-size: 22rpx; color: var(--ink-3); padding: 16rpx 0; }
.day { text-align: center; padding: 40rpx 0; }
.day-text { font-size: 24rpx; color: var(--ink-3); background: var(--glass); padding: 10rpx 30rpx; border-radius: 999rpx; }

.msg { display: flex; flex-direction: column; margin-bottom: 26rpx; max-width: 78%; }
.msg.mine { align-self: flex-end; align-items: flex-end; margin-left: auto; }
.msg.theirs { align-self: flex-start; align-items: flex-start; }
.bubble {
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  box-shadow: var(--shadow-sm);
}
.msg.mine .bubble {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-bottom-right-radius: 8rpx;
}
.msg.theirs .bubble {
  background: #fff;
  color: var(--ink);
  border-bottom-left-radius: 8rpx;
}
.msg-content { font-size: 28rpx; color: var(--ink); line-height: 1.6; word-break: break-all; }
.msg.mine .msg-content { color: #fff; }
.msg-time { font-size: 20rpx; color: var(--ink-3); margin-top: 8rpx; }

.input-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -8rpx 30rpx rgba(36,59,83,0.08);
}
.chat-input {
  flex: 1; height: 76rpx; background: var(--bg); border-radius: 999rpx;
  padding: 0 30rpx; font-size: 28rpx;
}
.ph { color: var(--ink-3); }
.send-btn {
  flex-shrink: 0; padding: 0 44rpx; height: 76rpx; line-height: 76rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; border: none;
}
.send-btn[disabled] { opacity: 0.5; }
