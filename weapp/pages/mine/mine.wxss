.mine-page { padding: 40rpx 28rpx; background: transparent; }
.profile-card {
  display: flex; align-items: center; gap: 26rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border: none;
}
.avatar-ring { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
.avatar-img { width: 98rpx; height: 98rpx; border-radius: 50%; }
.avatar { width: 98rpx; height: 98rpx; border-radius: 50%; background: #fff; color: var(--primary); font-size: 44rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.profile-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.nick { font-size: 38rpx; font-weight: bold; color: #fff; }
.source { background: rgba(255,255,255,0.25); color: #fff; font-size: 22rpx; }
.edit-link { color: rgba(255,255,255,0.9); font-size: 24rpx; }

/* 统计栏 */
.stats { display: flex; align-items: center; padding: 26rpx 10rpx; margin: 20rpx 0 0; }
.stat { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 40rpx; font-weight: 800; color: var(--ink); }
.stat-label { display: block; font-size: 23rpx; color: var(--ink-3); margin-top: 6rpx; }
.stat-div { width: 2rpx; height: 52rpx; background: var(--line); }

.menu-card { padding: 6rpx 24rpx; margin: 20rpx 0; }
.menu-item { display: flex; align-items: center; gap: 22rpx; padding: 30rpx 0; border-bottom: 1rpx solid var(--line); position: relative; }
.menu-item:last-child { border-bottom: none; }
.mi { font-size: 34rpx; }
.mi-t { flex: 1; font-size: 30rpx; color: var(--ink); }
.badge-wrap { position: relative; width: 0; height: 0; }
.mi-ar { color: var(--ink-3); font-size: 32rpx; }
.logout { margin-top: 20rpx; width: 100%; padding: 24rpx 0; }

.wx-btn { margin-top: 40rpx; width: 90%; background: linear-gradient(135deg, var(--primary), var(--primary-light)); border-radius: 999rpx; }
.acct-btn { margin-top: 20rpx; width: 90%; background: #fff; color: var(--primary); border: 2rpx solid var(--primary); border-radius: 999rpx; }
.login-card { padding: 60rpx 40rpx; text-align: center; margin-top: 120rpx; }
.login-ico-wrap { width: 140rpx; height: 140rpx; border-radius: 50%; background: var(--primary-soft); margin: 0 auto 24rpx; display: flex; align-items: center; justify-content: center; }
.login-ico { font-size: 70rpx; }
.login-title { display: block; font-size: 36rpx; font-weight: 800; color: var(--ink); margin-bottom: 12rpx; }
.login-desc { font-size: 26rpx; color: var(--ink-3); }

/* 强制公告弹层 */
.force-card {
  width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 44rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box; text-align: center;
}
.force-title { display: block; font-size: 34rpx; font-weight: 800; color: var(--ink); margin-bottom: 22rpx; }
.force-body { max-height: 50vh; }
.force-content { font-size: 27rpx; color: var(--ink-2); line-height: 1.8; white-space: pre-wrap; }
.force-btn { margin-top: 30rpx; width: 100%; padding: 24rpx 0; }
