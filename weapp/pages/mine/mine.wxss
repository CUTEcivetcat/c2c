.mine-page { padding: 40rpx 28rpx; background: transparent; }
.profile-card {
  display: flex; align-items: center; gap: 26rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border: none;
}
.avatar-ring { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar { width: 98rpx; height: 98rpx; border-radius: 50%; background: #fff; color: var(--primary); font-size: 44rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.profile-info { display: flex; flex-direction: column; gap: 12rpx; }
.nick { font-size: 38rpx; font-weight: bold; color: #fff; }
.source { background: rgba(255,255,255,0.25); color: #fff; font-size: 22rpx; }

.menu-card { padding: 6rpx 24rpx; margin: 20rpx 0; }
.menu-item { display: flex; align-items: center; gap: 22rpx; padding: 30rpx 0; border-bottom: 1rpx solid var(--line); }
.menu-item:last-child { border-bottom: none; }
.mi { font-size: 34rpx; }
.mi-t { flex: 1; font-size: 30rpx; color: var(--ink); }
.mi-ar { color: var(--ink-3); font-size: 32rpx; }
.logout { margin-top: 20rpx; width: 100%; padding: 24rpx 0; }

.wx-btn { margin-top: 40rpx; width: 90%; background: linear-gradient(135deg, var(--primary), var(--primary-light)); border-radius: 999rpx; }
.acct-btn { margin-top: 20rpx; width: 90%; background: #fff; color: var(--primary); border: 2rpx solid var(--primary); border-radius: 999rpx; }
.login-card { padding: 60rpx 40rpx; text-align: center; margin-top: 120rpx; }
.login-ico-wrap { width: 140rpx; height: 140rpx; border-radius: 50%; background: var(--primary-soft); margin: 0 auto 24rpx; display: flex; align-items: center; justify-content: center; }
.login-ico { font-size: 70rpx; }
.login-title { display: block; font-size: 36rpx; font-weight: 800; color: var(--ink); margin-bottom: 12rpx; }
.login-desc { font-size: 26rpx; color: var(--ink-3); }