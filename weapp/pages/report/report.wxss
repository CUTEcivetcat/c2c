.rp { padding: 28rpx 24rpx; background: transparent; }
.head-card { padding: 36rpx 30rpx; text-align: center; margin-bottom: 20rpx; }
.head-title { display: block; font-size: 34rpx; font-weight: 800; color: var(--ink); }
.head-sub { display: block; font-size: 24rpx; color: var(--ink-2); margin-top: 10rpx; }
.head-hint { display: block; font-size: 22rpx; color: var(--ink-3); margin-top: 12rpx; }

.form-card { padding: 6rpx 26rpx; }
.field { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.field:last-child { border-bottom: none; }
.label { width: 140rpx; font-size: 28rpx; color: var(--ink-2); flex-shrink: 0; font-weight: 600; }
.inp.val { flex: 1; font-size: 28rpx; color: var(--ink); }
.arrow { color: var(--ink-3); font-size: 32rpx; }
.field.col { flex-direction: column; align-items: stretch; gap: 14rpx; }
.reason { width: 100%; height: 200rpx; font-size: 27rpx; line-height: 1.6; }
.ph { color: var(--ink-3); }

.hint { text-align: center; font-size: 22rpx; color: var(--ink-3); margin: 20rpx 0; }
.submit-btn { width: 100%; padding: 26rpx 0; }
