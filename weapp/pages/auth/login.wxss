.lp { padding: 40rpx 44rpx; min-height: 100vh; background: transparent; }
.brand { text-align: center; padding-top: 8vh; margin-bottom: 60rpx; }
.logo-ring { width: 130rpx; height: 130rpx; border-radius: 50%; background: var(--primary-soft); display: flex; align-items: center; justify-content: center; margin: 0 auto 22rpx; box-shadow: var(--shadow-md); }
.logo { font-size: 70rpx; }
.title { display: block; font-size: 44rpx; font-weight: 800; color: var(--ink); }
.subtitle { display: block; font-size: 24rpx; color: var(--ink-3); margin-top: 12rpx; }
.tabs { display: flex; background: var(--glass); border-radius: var(--radius-lg); padding: 10rpx; box-shadow: var(--shadow-sm); margin-bottom: 40rpx; }
.tab { flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx; color: var(--ink-2); border-radius: var(--radius); }
.tab.active { background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: #fff; font-weight: 700; box-shadow: var(--shadow-md); }
.panel-desc { text-align: center; color: var(--ink-3); font-size: 26rpx; margin: 30rpx 0; display: block; }
.field { background: #fff; border: 2rpx solid var(--line); border-radius: var(--radius); padding: 22rpx 26rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); }
.inp { width: 100%; font-size: 28rpx; }
.ph { color: var(--ink-3); }
.code-row { display: flex; align-items: center; gap: 18rpx; }
.code-btn { flex-shrink: 0; background: var(--primary-soft); color: var(--primary); border-radius: 999rpx; padding: 14rpx 28rpx; font-size: 24rpx; font-weight: 600; }
.code-btn[disabled] { opacity: .6; }
.wechat-btn { width: 100%; padding: 26rpx 0; margin-top: 20rpx; }
.submit-btn { width: 100%; padding: 26rpx 0; margin-top: 10rpx; }
.hint { display: block; text-align: center; color: var(--ink-3); font-size: 22rpx; margin-top: 24rpx; }