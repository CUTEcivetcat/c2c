.dp { padding: 28rpx 24rpx 200rpx; background: transparent; }
.st-card {
  display: flex; align-items: center; gap: 18rpx; padding: 34rpx 30rpx; margin-bottom: 20rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light)); border-radius: var(--radius-lg);
  color: #fff; box-shadow: var(--shadow-md);
}
.st-ico { font-size: 44rpx; }
.st-main { display: flex; flex-direction: column; gap: 8rpx; }
.st-text { font-size: 36rpx; font-weight: bold; }
.st-sub { font-size: 22rpx; opacity: 0.9; }

.card { padding: 8rpx 26rpx; margin-bottom: 20rpx; }
.line { display: flex; justify-content: space-between; padding: 24rpx 0; font-size: 27rpx; border-bottom: 1rpx solid var(--line); align-items: center; }
.line:last-child { border-bottom: none; }
.l { color: var(--ink-3); flex-shrink: 0; }
.v { color: var(--ink); text-align: right; word-break: break-all; }
.v.hot { color: var(--primary); font-weight: bold; }
.copy { color: var(--ink); }
.copy-tag { font-size: 20rpx; color: var(--primary); background: var(--primary-soft); padding: 2rpx 12rpx; border-radius: 999rpx; margin-left: 8rpx; }

/* 商品卡 */
.product-card { display: flex; align-items: center; gap: 22rpx; padding: 24rpx 26rpx; }
.p-img { width: 130rpx; height: 130rpx; border-radius: 16rpx; background: #eef1f5; flex-shrink: 0; }
.p-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.p-title { font-size: 29rpx; color: var(--ink); line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.p-price { font-size: 34rpx; font-weight: 800; color: var(--primary); }
.ar { color: var(--ink-3); font-size: 32rpx; }

/* 地址 */
.addr-row { display: flex; gap: 20rpx; align-items: center; padding: 22rpx 0 4rpx; }
.addr-name { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.addr-phone { font-size: 26rpx; color: var(--ink-3); }
.addr-detail { display: block; font-size: 26rpx; color: var(--ink-2); line-height: 1.6; padding-bottom: 22rpx; }

/* 底部 */
.footer-bar { display: flex; gap: 16rpx; }
.bar-btn { flex: 1; padding: 22rpx 0; margin: 0; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.bar-btn.plain { background: #fff; color: var(--ink-2); border: 2rpx solid var(--line); }
.bar-btn[disabled] { opacity: 0.6; }
