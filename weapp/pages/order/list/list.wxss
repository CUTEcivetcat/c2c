.op { padding: 28rpx 24rpx; background: transparent; }
.tabs { display: flex; padding: 10rpx; margin-bottom: 20rpx; background: var(--glass); box-shadow: var(--shadow-sm); }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: var(--ink-2); border-radius: var(--radius); }
.tab.active { background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: #fff; font-weight: 700; box-shadow: var(--shadow-md); }

.status-bar { white-space: nowrap; margin-bottom: 20rpx; }
.st {
  display: inline-block; padding: 12rpx 30rpx; margin-right: 14rpx;
  background: #fff; border: 2rpx solid var(--line); border-radius: 999rpx;
  font-size: 25rpx; color: var(--ink-2);
}
.st.active { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); font-weight: 600; }

.card { padding: 24rpx; margin-bottom: 18rpx; }
.hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.no { font-size: 24rpx; color: var(--ink-3); }
.st { font-size: 22rpx; }
.bd { display: flex; gap: 20rpx; align-items: center; }
.img { width: 120rpx; height: 120rpx; border-radius: 16rpx; background: #eef1f5; flex-shrink: 0; }
.info { flex: 1; min-width: 0; }
.t { display: block; font-size: 29rpx; color: var(--ink); line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.time { display: block; font-size: 22rpx; color: var(--ink-3); margin-top: 10rpx; }
.mir { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.p { font-size: 32rpx; font-weight: 800; color: var(--primary); }
.ar { color: var(--ink-3); font-size: 32rpx; }
