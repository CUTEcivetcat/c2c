.detail-page { min-height: 100vh; background: transparent; padding: 0 0 160rpx; }
.gallery { width: 100%; background: #fff; }
.main-img { width: 100%; height: 620rpx; background: #eef1f5; display: block; }
.thumb-row { display: flex; gap: 14rpx; padding: 20rpx 24rpx; background: #fff; }
.thumb {
  width: 100rpx; height: 100rpx; border-radius: 14rpx; overflow: hidden;
  border: 4rpx solid transparent; box-sizing: border-box;
  transition: border-color 0.2s ease; opacity: 0.7;
}
.thumb.on { border-color: var(--primary); opacity: 1; }
.thumb-img { width: 100%; height: 100%; }

.info-card { margin: 20rpx 24rpx 0; padding: 28rpx; }
.price-row { display: flex; align-items: center; gap: 16rpx; }
.price { font-size: 52rpx; font-weight: 800; color: var(--primary); line-height: 1; }
.condition {
  background: var(--primary-soft); color: var(--primary); padding: 6rpx 18rpx;
  border-radius: 999rpx; font-size: 22rpx; font-weight: 600;
}
.title {
  display: block; font-size: 34rpx; font-weight: 700; color: var(--ink);
  margin: 20rpx 0; line-height: 1.4;
}
.meta { display: flex; gap: 30rpx; font-size: 24rpx; color: var(--ink-3); }
.meta-item { display: inline-flex; align-items: center; }

.desc-card { margin: 20rpx 24rpx 0; padding: 26rpx; }
.desc-label {
  display: block; font-size: 30rpx; font-weight: 700; color: var(--ink); margin-bottom: 16rpx;
  padding-left: 18rpx; border-left: 8rpx solid var(--primary);
}
.desc-text { font-size: 26rpx; color: var(--ink-2); line-height: 1.8; }

.buy-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.92); backdrop-filter: blur(14rpx);
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(36,59,83,0.1); z-index: 10;
}
.buy-btn { width: 100%; padding: 24rpx 0; }