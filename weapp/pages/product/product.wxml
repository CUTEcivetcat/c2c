<view class="detail-page fade-up" wx:if="{{p}}">
  <!-- 大图 -->
  <view class="gallery">
    <image class="main-img" src="{{activeImage}}" mode="aspectFill"/>
    <view class="thumb-row">
      <view wx:for="{{p.images}}" wx:key="index"
            class="thumb {{activeImage === item.url ? 'on' : ''}}"
            bindtap="changeImage" data-url="{{item.url}}">
        <image src="{{item.url}}" mode="aspectFill" class="thumb-img"/>
      </view>
    </view>
  </view>

  <!-- 信息卡 -->
  <view class="info-card glass-card">
    <view class="price-row">
      <text class="price">¥{{p.price}}</text>
      <text class="condition">{{p.conditionText}}</text>
    </view>
    <text class="title">{{p.title}}</text>
    <view class="meta">
      <text class="meta-item">📍 {{p.location || '同城'}}</text>
      <text class="meta-item">👀 {{p.viewCount}} 次浏览</text>
    </view>
  </view>

  <!-- 描述 -->
  <view class="desc-card glass-card">
    <text class="desc-label">商品描述</text>
    <text class="desc-text">{{p.description}}</text>
  </view>

  <!-- 底部购买栏 -->
  <view class="buy-bar">
    <button class="buy-btn btn-primary" bindtap="buyNow" disabled="{{buying}}">{{buying ? '下单中...' : '立即购买'}}</button>
  </view>
</view>

<view wx:else class="empty">
  <text class="empty-ico">⏳</text>
  加载中...
</view>