.mp { padding: 28rpx 24rpx; background: transparent; }
.card { display: flex; gap: 20rpx; padding: 22rpx; margin-bottom: 18rpx; align-items: center; }
.img { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: #eef1f5; flex-shrink: 0; }
.info { flex: 1; min-width: 0; }
.t { font-size: 29rpx; color: var(--ink); line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.p-id { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.p { font-size: 32rpx; font-weight: 800; color: var(--primary); }
.st { font-size: 22rpx; color: var(--ink-3); }
.ops { display: flex; gap: 14rpx; margin-top: 14rpx; }
.op-edit { margin: 0; padding: 10rpx 36rpx; background: var(--primary-soft); color: var(--primary); font-size: 24rpx; border-radius: 999rpx; line-height: 1.4; }
.op-off { margin: 0; padding: 10rpx 36rpx; background: #fff; color: var(--danger); border: 2rpx solid var(--danger); font-size: 24rpx; border-radius: 999rpx; line-height: 1.4; }