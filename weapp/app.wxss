/**
 * 闲小鱼 C2C 小程序 — 全局设计系统
 * 风格参考 uiverse.io:玻璃拟态面板、渐变主按钮、柔和阴影、大圆角、克制配色。
 */

/* ===== 设计令牌 (通过 CSS 变量注入,可被各页复用) ===== */
page {
  --primary: #ff6b35;
  --primary-light: #ff8c5a;
  --primary-dark: #e55a2b;
  --primary-soft: #fff1ea;
  --success: #07c160;
  --danger: #e74c3c;
  --warning: #fdcb6e;
  --info: #74b9ff;
  --ink: #243b53;
  --ink-2: #52606d;
  --ink-3: #9aa5b1;
  --line: #e6e9ee;
  --bg: #f4f6f9;
  --glass: rgba(255, 255, 255, 0.82);
  --radius: 20rpx;
  --radius-lg: 28rpx;
  --shadow-sm: 0 4rpx 14rpx rgba(36, 59, 83, 0.06);
  --shadow-md: 0 10rpx 30rpx rgba(255, 107, 53, 0.12);
  --shadow-lg: 0 20rpx 50rpx rgba(36, 59, 83, 0.12);
}

page {
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--ink);
  font-size: 28rpx;
}

/* ===== 通用页面容器 ===== */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background:
    radial-gradient(1200rpx 600rpx at 90% -4%, rgba(255, 140, 90, 0.14), transparent 60%),
    radial-gradient(900rpx 500rpx at -10% 20%, rgba(116, 185, 255, 0.12), transparent 60%),
    var(--bg);
}

/* ===== 玻璃拟态卡片 ===== */
.glass-card {
  background: var(--glass);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(14rpx);
}

/* ===== 主渐变按钮 ===== */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-md);
  transition: all 0.25s ease;
}
.btn-primary:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.18);
}
.btn-primary[disabled] {
  opacity: 0.6;
  box-shadow: none;
}

/* ===== 描边 / 弱按钮 ===== */
.btn-ghost {
  background: #fff;
  color: var(--ink-2);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 28rpx;
  transition: all 0.25s ease;
}
.btn-ghost:active { background: var(--primary-soft); color: var(--primary); border-color: var(--primary); }

/* ===== 输入框 ===== */
.input {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--ink);
  transition: border-color 0.25s, box-shadow 0.25s;
}
.input:focus { border-color: var(--primary); box-shadow: 0 0 0 6rpx rgba(255, 107, 53, 0.12); }

/* ===== 标签 / 徽章 ===== */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 500;
}

/* ===== 空态 ===== */
.empty {
  padding: 120rpx 20rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
}
.empty-ico { font-size: 80rpx; display: block; margin-bottom: 18rpx; opacity: 0.8; }

/* ===== 内联 loading 动画 ===== */
.spinner {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid var(--line);
  border-top-color: var(--primary);
  border-radius: 50%;
  margin: 60rpx auto;
  animation: dshspin 0.8s linear infinite;
}
@keyframes dshspin { to { transform: rotate(360deg); } }

/* ===== 入场动画 ===== */
.fade-up { animation: fadeUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}