# ============================================================
# C2C 项目 .gitignore
# 用于开源上传时防止敏感文件 / 构建产物进入仓库。
# 参考 c2cgit 副本的规则，并针对本项目的 config 外部化做了加强。
# 注意：gitignore 不支持行内注释，注释一律独立成行。
# ============================================================

# ===== 敏感配置：config/ 目录（真实值，绝不上传）=====
config/*
!config/application.example.yml
!config/*.example.*
!config/README.md
# 注：config/ 下的 application*.yml、pro.xml、test.xml、服务器密码.txt
#     都含真实 IP/密码，全部被上面 config/* 排除；只放行 example 演示文件。

# ===== 数据库导出（含真实业务数据，绝不上传）=====
sql/c2c.sql
sql/c2cnew.sql
sql/c2c-monolith.sql
sql/rebuild-full.sql
sql/*.sql.bak

# ===== 部署/运维文档（含真实 IP/密码，仅本地维护）=====
deploy/docs/

# ===== deploy 下含真实 IP/密码的文件（真实版排除，脱敏 example 版放行）=====
deploy/baota-site-*.conf
!deploy/baota-site.example.conf
deploy/upload-frontend.sh
!deploy/upload-frontend.example.sh
deploy/nginx-c2c.conf
!deploy/nginx-c2c.example.conf

# ===== 本地 Git 运维文档/脚本（含真实值，仅存于 c2c，不进入仓库）=====
Git上传与同步规则.md
scripts/

# ===== 本地 agent 技能（.dsh/skills，个人开发辅助，不进仓库）=====
.dsh/

# ===== git 备份目录 =====
.git-backup-*/

# ===== 构建产物 =====
target/
**/node_modules/
**/dist/
*.class

# ===== 运行数据 =====
logs/
uploads/
*.log

# ===== IDE / 本地 =====
.idea/
*.iml
.vscode/
*.local

# ===== 前端本地环境变量（含代理地址等本地敏感信息）=====
frontend/.env.local
admin-frontend/.env.local
blog/.env.local
.env.local

# ===== 其它 =====
openapi.json
.DS_Store
Thumbs.db
